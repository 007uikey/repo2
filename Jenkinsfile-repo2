pipeline {

    agent any

    stages {

        stage('clone repo2') {

            steps {
                git branch: '2026Q1',
                url: 'https://github.com/007uikey/Repo2.git'

            }
        }

        stage('Delete old websites') {

            steps {

                sh 'rm -rf /var/www/html/*'

            }
        }

        stage('Deploy repo2 and set permission') {

            steps {

                sh 'sudo cp -r * /var/www/html/'
                sh 'sudo chmod -R 777 /var/www/html'
            }
        }
    }
}
